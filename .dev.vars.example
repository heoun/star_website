# Copy to .dev.vars and fill in. .dev.vars is gitignored, is never uploaded by
# `wrangler deploy`, and does not exist in GitHub Actions — nothing here can
# reach production.
#
#     cp .dev.vars.example .dev.vars
#
# Keys are left present and empty rather than commented out: a value typed
# after a "#" looks filled in but is not. `npm run dev` says which of the two
# it is finding.

# Lets you into /admin locally. Cloudflare Access does not exist on your
# machine, so without this every admin route answers 403. It is only honoured
# on a loopback hostname, so setting it can never open production.
# Use your own address: it is what the audit trail records for local changes.
DEV_ADMIN_EMAIL=

# Which half of the console to be locally: "manager" or "agent". Blank means
# manager, which is what a local session has always been.
#
# Usually you do not need this: `npm run dev:agent` starts the same server as
# an agent for one session, which is easier than editing this and remembering
# to change it back. Set it here only if you want agent to be your default.
#
# As an agent you see what an agent sees — the 125 landlord values read-only,
# no Properties screen, and every attempt to write one refused by the Worker
# rather than merely hidden.
# In production the role comes from public.staff, never from a variable.
DEV_ADMIN_ROLE=

# The DEVELOPMENT Supabase project — not production. Create a second free
# project and run supabase/schema.sql on it, then paste its details here.
# The admin page prints the project name it is connected to, so if this ever
# says production you will see it before you delete anything.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The same project's low-privilege key: the publishable key
# (sb_publishable_…) if the project has one, otherwise the legacy anon key.
# Supabase retires the legacy one at the end of 2026; set whichever name
# matches what you copied and the Worker takes it — publishable wins if both
# are set. The applicant portal signs people in through Supabase Auth and
# this is the key its API expects; it stays in the Worker, the browser never
# sees it. Tip for local work: turning OFF "Confirm email" in the dev
# project's Auth settings skips the email-code step, so registering locally
# signs straight in.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_ANON_KEY=

# What to call this project in the admin banner. Supabase keeps the display
# name in its dashboard only — neither the URL nor the key carries it — so
# write it down here. The project ref is shown beside it either way.
DEV_SUPABASE_LABEL=

# Encrypts applicant SSNs. A throwaway value is right here — it must NOT be the
# production key, or a local database dump would decrypt real applications.
#     openssl rand -base64 32
APP_ENCRYPTION_KEY=

# Optional. Listing photos live in R2, and your local bucket is empty, so every
# image 404s and the site looks broken. With this set, a local miss is read from
# the live site instead. Reading only — uploads and deletes stay local.
DEV_MEDIA_ORIGIN=https://starreusa.com

# Emails. On a loopback request the Worker prints every email to this terminal
# instead of sending it, so local form submissions never reach a real inbox.
# For a delivery rehearsal before a launch, set DEV_REAL_EMAIL=true AND fill in
# a RESEND_API_KEY — local emails then really send, to whatever address is in
# the form. Make a separate key named "dev" in the Resend dashboard so it can
# be revoked on its own, and set the flag back to empty when you are done.
RESEND_API_KEY=
DEV_REAL_EMAIL=

# Deliberately absent: TURNSTILE_SECRET_KEY. Human verification is skipped when
# it is unset, which is what you want locally. CF_ACCESS_TEAM_DOMAIN and
# CF_ACCESS_AUD are production-only.
