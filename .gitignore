# Working files (design drafts, requirement docs) live in notes/, out of git.
notes/
*.docx
# The lease template is a source file, not a working draft, so it stays in git.
# The filled-in lease it was built from does not: it carries a real tenant name.
!lease/template/*.docx
# The tools write a backup beside it before rewriting it. That is a scratch
# copy of the template, not a second source of truth.
*.docx.bak
__pycache__/

# Share configuration templates, never local credentials.
!.dev.vars.example
!.env.example

# Browser automation output and local test/build caches.
.playwright-mcp/
playwright-report/
test-results/
coverage/
*.log
*.tsbuildinfo

# Requirement spreadsheets belong under ignored notes/, not the repository root.
/lease-information*.xlsx
