{
  "name": "star-website",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "dev": "node scripts/dev.js",
    "dev:agent": "node scripts/dev.js --var DEV_ADMIN_ROLE:agent",
    "preview": "node server.js",
    "seed:dev": "node scripts/seed-dev.js",
    "deploy": "npx --yes wrangler@4 deploy",
    "gate": "depcruise backend worker --config backend/tools/arch-gate/dependency-cruiser.cjs",
    "typecheck": "tsc -p backend/tsconfig.json",
    "smoke": "node backend/tools/smoke.mjs",
    "test:workspace": "node backend/tools/test-workspace.mjs",
    "test:workspace:db": "node backend/tools/test-workspace-schema.mjs",
    "test:portal": "node backend/tools/test-portal-request.mjs",
    "test:administration": "node backend/tools/test-administration.mjs",
    "test:administration:db": "node backend/tools/test-administration-schema.mjs",
    "test:demo": "node scripts/test-demo-data.mjs",
    "demo:workspace": "npm run build && node scripts/demo-workspace.mjs",
    "test:property": "node scripts/test-property-flow.mjs",
    "test:listings": "node scripts/test-listing-editor.mjs",
    "test:listings:db": "node scripts/test-listing-schema.mjs",
    "test:case-review": "node scripts/test-case-review.mjs",
    "test:case-queue": "node scripts/test-case-queue.mjs",
    "test:identity": "node scripts/test-identity.mjs",
    "test:identity:db": "node scripts/test-identity-schema.mjs",
    "test:identity:ui": "node scripts/test-identity-ui.mjs",
    "test:storage": "node scripts/test-storage.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "dependency-cruiser": "^16.0.0",
    "typescript": "^5.6.0"
  }
}
