{
  "name": "star-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-01",
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "STORAGE_BACKEND": "supabase" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // These paths must reach the Worker even though matching assets exist:
    // the listings feed is served from Supabase, and /admin is access-checked.
    "run_worker_first": ["/data/listings.json", "/data/property.json", "/admin", "/admin/*", "/api/*", "/media/*"]
  },
  // Retained for local/offline development with STORAGE_BACKEND=r2.
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "listing-media" },
    // Applicant documents (IDs, paystubs, bank statements). Private: served
    // only through authenticated portal and admin routes, never at /media/.
    { "binding": "APPLICANT_DOCS", "bucket_name": "applicant-docs" }
  ],
  "observability": {
    "enabled": true
  }
}
