{
  "version": 1,
  "template": "lease/template/lease-template.docx",
  "placeholder_syntax": "{{group.field}}",
  "sources": {
    "deal": "Filled from the application and the listing. The agent confirms it.",
    "manager": "A building or company default, set once in admin settings.",
    "agent": "The agent types this in for each lease.",
    "_needs_setup": "Fields marked needs_setup have no default because the source lease left them blank. A manager has to supply a value before the first lease is generated.",
    "_scope": "manager fields carry a scope: 'company' settings are the same everywhere; 'building' settings differ per building and their defaults came from one specific building, so review them before reusing.",
    "_source_value": "The value the sample lease carried, kept as provenance. It is not a default: reusing it elsewhere would name the wrong entity or escrow account."
  },
  "groups": [
    {
      "id": "lease_terms",
      "label": "Lease terms",
      "description": "Dates, rent and the security deposit."
    },
    {
      "id": "parties",
      "label": "Parties",
      "description": "Who the tenant and the landlord are."
    },
    {
      "id": "property",
      "label": "Property",
      "description": "The unit's address, whole and in parts."
    },
    {
      "id": "contacts",
      "label": "Contacts",
      "description": "Payment, management, legal notice and emergency contacts."
    },
    {
      "id": "fees",
      "label": "Fees and thresholds",
      "description": "Standing charges and limits written into the lease."
    },
    {
      "id": "utilities",
      "label": "Utilities",
      "description": "Who pays for each utility or service."
    },
    {
      "id": "keys",
      "label": "Keys",
      "description": "Keys issued and their replacement charges."
    },
    {
      "id": "fines",
      "label": "Fine schedule",
      "description": "Penalty per occurrence for each house rule violation."
    },
    {
      "id": "building_disclosures",
      "label": "Building disclosures",
      "description": "Sprinkler, bedbug, gas and smoking disclosures required by law."
    },
    {
      "id": "good_cause",
      "label": "Good Cause Eviction notice",
      "description": "Whether Article 6-A applies to the unit, and why not if it does not."
    },
    {
      "id": "forms",
      "label": "Statutory forms",
      "description": "DHCR consent and the window guard notice."
    }
  ],
  "fields": [
    {
      "id": "lease.effective_date",
      "label": "Lease date (the date the lease is sent out)",
      "group": "lease_terms",
      "source": "deal",
      "type": "date",
      "required": true,
      "default": null,
      "from": "generated.today",
      "note": "Prints on the first page and in the preamble of every rider."
    },
    {
      "id": "lease.commencement_date",
      "label": "Move-in date",
      "group": "lease_terms",
      "source": "deal",
      "type": "date",
      "required": true,
      "default": null,
      "from": "applications.move_in"
    },
    {
      "id": "lease.end_date",
      "label": "Lease end date",
      "group": "lease_terms",
      "source": "deal",
      "type": "date",
      "required": true,
      "default": null,
      "from": "computed: move_in + applications.lease_term_months - 1 day"
    },
    {
      "id": "lease.end_time",
      "label": "Lease ends at",
      "group": "lease_terms",
      "source": "manager",
      "type": "text",
      "required": true,
      "default": "11:59 PM",
      "scope": "company"
    },
    {
      "id": "lease.vacancy_lease_date",
      "label": "Date of vacancy lease (bedbug disclosure)",
      "group": "lease_terms",
      "source": "agent",
      "type": "date",
      "required": false,
      "default": null,
      "note": "Deliberately left blank in the template; the agent fills it in before sending."
    },
    {
      "id": "rent.monthly",
